# Copy to .env and fill in. Never commit the real .env.

# --- Server ---
PORT=5001
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated browser origins allowed to call the API (leave empty to allow all in development)
CORS_ORIGIN=

# --- PostgreSQL ---
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSLMODE=require

# --- Google OAuth (YouTube) ---
client_id=
client_secret=
grant_type=refresh_token
# Optional: lets "What are viewers saying?" read public comments without the youtube.force-ssl permission.
# Google Cloud -> APIs & Services -> Credentials -> Create API key (restrict it to YouTube Data API v3)
YOUTUBE_API_KEY=

# --- Instagram auto-replies (webhooks) ---
# From Meta for Developers -> your app -> App settings -> Basic -> App secret
META_APP_SECRET=
# Webhooks from "Instagram API with Instagram login" are signed with THIS one instead:
# Meta for Developers -> your app -> Instagram -> API setup with Instagram login -> Instagram app secret
INSTAGRAM_APP_SECRET=
# "Connect Instagram" on /accounts: the Instagram app ID from the same page. Add these under
# "Business login settings -> OAuth redirect URIs": <your site>/api/instagram/callback (and http://localhost:5173/api/instagram/callback)
INSTAGRAM_APP_ID=
# Optional: defaults to <the site you clicked from>/api/instagram/callback
INSTAGRAM_REDIRECT_URI=
# Any long random string you also paste into the Meta webhook "Verify token" box
WEBHOOK_VERIFY_TOKEN=
# Optional: set to true to record what WOULD be sent without messaging anyone (safe first run)
AUTOMATION_DRY_RUN=false
# Optional: public https address of this server, if the page shows the wrong webhook URL
PUBLIC_BASE_URL=https://cms.changtechs.com/

# --- LinkedIn (the "Connect LinkedIn" button on /accounts) ---
# LinkedIn Developers -> your app -> Auth -> Client ID / Primary Client Secret
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional: defaults to "rw_organization_admin r_organization_social r_organization_followers r_organization_social_feed" (company pages, Community Management API)
LINKEDIN_SCOPES=
# Optional: defaults to <the site you clicked from>/api/linkedin/callback.
# Whatever it is, add it under Auth -> "Authorized redirect URLs for your app", e.g.
#   http://localhost:5173/api/linkedin/callback   and   https://cms.changtechs.com/api/linkedin/callback
LINKEDIN_REDIRECT_URI=
# Optional: LinkedIn API version (YYYYMM). Defaults to two months before today.
LINKEDIN_API_VERSION=

# --- Social Post (publishing) ---
# Google Cloud Storage bucket for uploaded images/videos. Instagram and Facebook download media from its public URL,
# so give "allUsers" the "Storage Object Viewer" role on the bucket, and add a CORS rule allowing PUT from your site:
#   [{"origin":["https://cms.changtechs.com","http://localhost:5173"],"method":["PUT"],"responseHeader":["Content-Type"],"maxAgeSeconds":3600}]
# Credentials: on Cloud Run the service account is used (it needs "Storage Object Admin" and "Service Account Token Creator"
# on itself to sign upload URLs). Locally, point GOOGLE_APPLICATION_CREDENTIALS at a service-account JSON key.
GCS_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=
# Facebook Login for Pages (the "Connect Facebook" button). Meta for Developers -> your app -> App settings -> Basic
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Optional: defaults to <the site you clicked from>/api/facebook/callback (add it under Facebook Login -> Valid OAuth Redirect URIs)
# Facebook Login for Business apps: the Configuration ID from Facebook Login for Business -> Configurations
FACEBOOK_CONFIG_ID=
FACEBOOK_REDIRECT_URI=
# Optional: defaults to <the site you clicked from>/api/google/callback (add it to the Google OAuth client's redirect URIs)
GOOGLE_REDIRECT_URI=
# Optional: LinkedIn personal-profile scopes (needs the "Share on LinkedIn" and "Sign In with LinkedIn using OpenID Connect" products)
LINKEDIN_PERSON_SCOPES=
# Set to true to stop the every-minute publishing queue (scheduled posts, retries)
DISABLE_PUBLISH_CRON=false

# --- Jobs ---
# Set to true to turn off the built-in nightly sync / 6-hourly stories capture
DISABLE_SNAPSHOT_CRON=false
# Days of daily insights kept in the database (default 30). Older days are deleted nightly;
# ranges outside this window (and custom ranges) are fetched live from the platforms.
# Use 60 to keep "vs previous 30 days" comparisons in the database instead of fetching them live.
INSIGHTS_RETENTION_DAYS=30

# --- Local testing of Instagram/Facebook login ---
# `npm run dev:tunnel` gives an https address for your local app. Extra hostnames Vite should accept
# (comma-separated, a leading dot allows subdomains). Default: .trycloudflare.com
DEV_ALLOWED_HOSTS=
